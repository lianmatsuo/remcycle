#!/usr/bin/env bash
# The gate: what has to pass before a change is done. CI runs this same file.
#
#   scripts/check          everything
#   scripts/check python   the dream command: lint and tests
#   scripts/check mod      the Claude Code mod: manifest, types and tests
#   scripts/check commits  the subjects of the commits this branch adds
set -euo pipefail
# A CDPATH from the caller's shell would send a relative cd somewhere else.
unset CDPATH
cd "$(dirname "$0")/.."

TYPESCRIPT=7.0.2
# Mods are on by default from this version of Claude Code.
MODS_SINCE=2.1.287
COMMIT_TYPES='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'

step() {
  printf '\n== %s\n' "$1"
  shift
  "$@"
}

check_python() {
  step "python lint" uv run --locked ruff check
  step "python tests" uv run --locked pytest -q
}

check_mod() {
  if ! command -v claude >/dev/null; then
    echo "The mod's checks run inside Claude Code, and no claude command is on the path." >&2
    echo "Install Claude Code, or run: scripts/check python" >&2
    exit 1
  fi
  local have
  have="$(claude --version | awk '{print $1}')"
  if [ "$(printf '%s\n%s\n' "$MODS_SINCE" "$have" | sort -V | head -n 1)" != "$MODS_SINCE" ]; then
    echo "The mod's checks need Claude Code $MODS_SINCE or later, and this is $have." >&2
    echo "Bring it up to date with: claude update. Or run: scripts/check python" >&2
    exit 1
  fi
  step "mod manifest" claude plugin validate mod
  # Claude Code writes the declarations of its mods API into the mod's folder each time it loads
  # the mod. Running the mod's own command loads it once, with no sign-in and none of the person's
  # settings. The old copy is cleared first, so that a load which wrote nothing fails the typecheck.
  rm -f mod/.claude-plugin/types/claude-code/index.d.ts
  step "mod type declarations, from the installed Claude Code" \
    env -u CLAUDE_CODE_PLUGIN_DIRS claude --plugin-dir mod --setting-sources "" --no-session-persistence -p "/remcycle" </dev/null
  step "mod types" pnpm --package="typescript@$TYPESCRIPT" dlx tsc -p mod/tsconfig.json
  step "mod tests" claude plugin test mod
}

commit_subjects() {
  local base="$1" subject bad=0
  local conventional="^($COMMIT_TYPES)(\\([a-z0-9][a-z0-9-]*\\))?!?: [^ ]"
  if ! git rev-parse --verify --quiet "$base" >/dev/null; then
    echo "There is no $base to compare with. Set CHECK_BASE to the branch this one started from." >&2
    return 1
  fi
  while IFS= read -r subject; do
    if [[ ! $subject =~ $conventional ]]; then
      echo "not a conventional commit: $subject" >&2
      bad=1
    fi
  done < <(git log --no-merges --format=%s "$base..HEAD")
  if [ "$bad" = 1 ]; then
    echo "A subject reads type(scope): summary, with the scope optional. The types: ${COMMIT_TYPES//|/, }." >&2
    return 1
  fi
}

check_commits() {
  # Only what the branch adds is checked: main holds commits from before the rule.
  local base="${CHECK_BASE:-origin/main}"
  step "commit subjects since $base" commit_subjects "$base"
}

case "${1:-all}" in
  all)
    check_python
    check_mod
    check_commits
    ;;
  python) check_python ;;
  mod) check_mod ;;
  commits) check_commits ;;
  *)
    echo "usage: scripts/check [python|mod|commits]" >&2
    exit 2
    ;;
esac

printf '\nAll checks passed.\n'
